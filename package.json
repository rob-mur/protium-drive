{
    "name": "protium-drive",
    "version": "0.1.0",
    "private": true,
    "description": "protium-drive: an unofficial third-party client, not supported by Proton. Serves Proton Drive over local WebDAV through the Proton Drive SDK, for rclone to mount.",
    "license": "MIT",
    "type": "module",
    "bin": {
        "protium-drive": "src/main.ts"
    },
    "scripts": {
        "start": "bun src/main.ts",
        "test": "bun test",
        "check-types": "tsc --noEmit",
        "bench": "bun bench/main.ts",
        "build": "bun build src/main.ts src/proton/crypto-worker.ts --compile --outfile dist/protium-drive"
    },
    "dependencies": {
        "@protontech/crypto": "2.0.0",
        "@protontech/drive-sdk": "0.23.0",
        "ky": "^1.14.3"
    },
    "devDependencies": {
        "@types/bun": "^1.3.0",
        "typescript": "^5.9.3"
    },
    "patchedDependencies": {
        "@protontech/crypto@2.0.0": "patches/@protontech%2Fcrypto@2.0.0.patch",
        "@protontech/drive-sdk@0.23.0": "patches/@protontech%2Fdrive-sdk@0.23.0.patch"
    }
}
