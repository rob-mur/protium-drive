{
    "name": "proton-drive-mount",
    "version": "0.1.0",
    "private": true,
    "description": "Serve Proton Drive over local WebDAV through the official Proton Drive SDK, for rclone to mount.",
    "license": "MIT",
    "type": "module",
    "bin": {
        "proton-drive-mount": "src/main.ts"
    },
    "scripts": {
        "start": "bun src/main.ts",
        "test": "bun test",
        "check-types": "tsc --noEmit",
        "build": "bun build src/main.ts --compile --outfile dist/proton-drive-mount"
    },
    "dependencies": {
        "@protontech/crypto": "2.0.0",
        "@protontech/drive-sdk": "0.23.0",
        "ky": "^1.14.3"
    },
    "devDependencies": {
        "@types/bun": "^1.3.0",
        "typescript": "^5.9.3"
    },
    "patchedDependencies": {
        "@protontech/crypto@2.0.0": "patches/@protontech%2Fcrypto@2.0.0.patch",
        "@protontech/drive-sdk@0.23.0": "patches/@protontech%2Fdrive-sdk@0.23.0.patch"
    }
}
